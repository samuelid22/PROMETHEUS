# Copy the required values into your local .env or hosting-provider environment.
# Leave secret values out of this file.

# Backend secrets and deployment configuration
GEMINI_API_KEY=
PROMETHEUS_CORS_ORIGINS=
PROMETHEUS_NIMIQ_RECIPIENT=
PROMETHEUS_NIMIQ_AMOUNT_LUNA=1000000
PROMETHEUS_NIMIQ_RPC_URL=https://<your-testnet-rpc-host>/
PROMETHEUS_NIMIQ_NETWORK=testnet
PROMETHEUS_NIMIQ_CONFIRMATIONS=1
PROMETHEUS_API_OUTPUT_DIR=/tmp/prometheus-output
PROMETHEUS_API_UPLOAD_DIR=/tmp/prometheus-uploads
PROMETHEUS_PAYMENT_DB=/tmp/prometheus-payments.db

# Frontend public build configuration
VITE_API_BASE_URL=

# Separate TEST wallet-proof backend only (no Gemini key or merchant credentials).
# Do not enable these on the production analysis backend.
PROMETHEUS_WALLET_AUTH_ENABLED=false
PROMETHEUS_WALLET_AUTH_ORIGIN=https://<stable-test-preview-host>
PROMETHEUS_WALLET_AUTH_DB=/tmp/prometheus-wallet-auth.db
# Vercel Preview only, scoped to the TEST branch. Never replace VITE_API_BASE_URL.
VITE_WALLET_AUTH_BASE_URL=https://<test-wallet-auth-backend-host>
